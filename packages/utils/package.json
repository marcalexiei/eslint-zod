{
  "name": "@eslint-zod/utils",
  "version": "4.0.0",
  "description": "Shared utilities for eslint-zod plugins",
  "keywords": [
    "eslint",
    "eslint-plugin",
    "utils",
    "zod"
  ],
  "homepage": "https://github.com/marcalexiei/eslint-zod#readme",
  "bugs": {
    "url": "https://github.com/marcalexiei/eslint-zod/issues"
  },
  "license": "MIT",
  "author": "Marco Pasqualetti @marcalexiei",
  "repository": {
    "type": "git",
    "url": "https://github.com/marcalexiei/eslint-zod",
    "directory": "packages/utils"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "@eslint-zod/source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./rule-builders/*": {
      "@eslint-zod/source": "./src/rule-builders/*.ts",
      "import": {
        "types": "./dist/rule-builders/*.d.mts",
        "default": "./dist/rule-builders/*.mjs"
      },
      "require": {
        "types": "./dist/rule-builders/*.d.cts",
        "default": "./dist/rule-builders/*.cjs"
      }
    },
    "./rule-patterns/*": {
      "@eslint-zod/source": "./src/rule-patterns/*.ts",
      "import": {
        "types": "./dist/rule-patterns/*.d.mts",
        "default": "./dist/rule-patterns/*.mjs"
      },
      "require": {
        "types": "./dist/rule-patterns/*.d.cts",
        "default": "./dist/rule-patterns/*.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "lint:publish": "attw --pack .",
    "test": "vitest"
  },
  "dependencies": {
    "@typescript-eslint/utils": "catalog:deps",
    "esquery": "^1.6.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:dev",
    "@eslint-zod/tooling": "workspace:*",
    "@types/esquery": "1.5.4",
    "tsdown": "catalog:dev",
    "vitest": "catalog:dev"
  },
  "engines": {
    "node": "^20 || ^22 || >=24"
  }
}
