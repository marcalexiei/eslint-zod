{
  "name": "eslint-zod",
  "private": true,
  "license": "MIT",
  "author": "Marco Pasqualetti @marcalexiei",
  "repository": {
    "type": "git",
    "url": "https://github.com/marcalexiei/eslint-zod"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "tsc -b",
    "lint": "pnpm run lint:js && pnpm run lint:docs && pnpm run lint:knip",
    "lint:js": "eslint .",
    "lint:js:fix": "eslint . --fix",
    "lint:docs": "pnpm -r lint:docs",
    "lint:knip": "knip",
    "lint:publish": "pnpm -r lint:publish && pnpm run lint:dts",
    "lint:dts": "node scripts/lint-dts.ts",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "release": "pnpm run build && changeset publish",
    "check-all": "pnpm run format && pnpm run build && pnpm run lint && pnpm run lint:publish && pnpm run test && pnpm run typecheck",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@marcalexiei/eslint-config": "7.0.0",
    "@marcalexiei/prettier-config": "catalog:dev",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "catalog:dev",
    "@vitest/eslint-plugin": "1.6.27",
    "eslint": "10.13.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-eslint-plugin": "7.6.2",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-n": "18.5.0",
    "knip": "6.42.1",
    "lefthook": "2.2.1",
    "prettier": "catalog:dev",
    "typescript": "6.0.3",
    "typescript-eslint": "catalog:dev",
    "vitest": "catalog:dev"
  },
  "prettier": "@marcalexiei/prettier-config",
  "engines": {
    "node": "^20 || ^22 || >=24"
  },
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61"
}
