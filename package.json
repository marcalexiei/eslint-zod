{
  "name": "eslint-zod",
  "private": true,
  "license": "MIT",
  "author": "Marco Pasqualetti @marcalexiei",
  "repository": {
    "type": "git",
    "url": "https://github.com/marcalexiei/eslint-zod"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "tsc -b",
    "lint": "pnpm run lint:js && pnpm run lint:docs && pnpm run lint:knip",
    "lint:js": "eslint .",
    "lint:js:fix": "eslint . --fix",
    "lint:docs": "pnpm -r lint:docs",
    "lint:knip": "knip",
    "lint:publish": "pnpm -r lint:publish && pnpm run lint:dts",
    "lint:dts": "node scripts/lint-dts.ts",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "release": "pnpm run build && changeset publish",
    "validate": "pnpm run format && pnpm run build && pnpm run lint && pnpm run lint:publish && pnpm run test && pnpm run typecheck",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@marcalexiei/eslint-config": "8.0.0",
    "@marcalexiei/prettier-config": "catalog:dev",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "catalog:dev",
    "@vitest/eslint-plugin": "1.6.28",
    "eslint": "10.14.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-eslint-plugin": "7.6.2",
    "eslint-plugin-import-x": "4.18.1",
    "eslint-plugin-n": "18.5.0",
    "knip": "6.45.1",
    "lefthook": "2.2.1",
    "prettier": "catalog:dev",
    "typescript": "6.0.3",
    "typescript-eslint": "catalog:dev",
    "vitest": "catalog:dev"
  },
  "prettier": "@marcalexiei/prettier-config",
  "engines": {
    "node": "^20 || ^22 || >=24"
  },
  "packageManager": "pnpm@12.23.0+sha512.02da94ffaf133f46074322afe552f90d40b5f71ae259aefbccdacc5085b1d617e98d65e0131f5748b9b67445978ee5055d7d59a473f1eef0d504854fefcd5975"
}
