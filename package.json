{
  "name": "eslint-zod",
  "private": true,
  "license": "MIT",
  "author": "Marco Pasqualetti @marcalexiei",
  "repository": {
    "type": "git",
    "url": "https://github.com/marcalexiei/eslint-zod"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "tsc -b",
    "lint": "pnpm run lint:js && pnpm run lint:docs && pnpm run lint:knip",
    "lint:js": "eslint .",
    "lint:js:fix": "eslint . --fix",
    "lint:docs": "pnpm -r lint:docs",
    "lint:knip": "knip",
    "lint:publish": "pnpm -r lint:publish",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "release": "pnpm run build && changeset publish",
    "check-all": "pnpm run format && pnpm run build && pnpm run lint && pnpm run lint:publish && pnpm run test && pnpm run typecheck",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.2",
    "@marcalexiei/eslint-config": "7.0.0",
    "@marcalexiei/prettier-config": "catalog:dev",
    "@types/node": "24.13.2",
    "@vitest/coverage-v8": "catalog:dev",
    "@vitest/eslint-plugin": "1.6.27",
    "eslint": "10.10.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-eslint-plugin": "7.6.2",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-n": "18.3.0",
    "knip": "6.35.1",
    "lefthook": "2.1.12",
    "prettier": "catalog:dev",
    "typescript": "6.0.3",
    "typescript-eslint": "catalog:dev",
    "vitest": "catalog:dev"
  },
  "prettier": "@marcalexiei/prettier-config",
  "engines": {
    "node": "^20 || ^22 || >=24"
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621"
}
